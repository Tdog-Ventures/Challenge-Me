# ---------------------------------------------------------------------------
# Challenge-Me environment template. Copy to .env.local for local dev.
# Real values live in Vercel Dashboard > Settings > Environment Variables.
# NEVER commit a filled-in copy of this file.
# ---------------------------------------------------------------------------

# Public site URL. Used by the Facebook cron to build the challenge link.
# Adelaide shopfront; also the Vercel production domain.
NEXT_PUBLIC_BASE_URL=https://challenge-me-2ddx.vercel.app

# Facebook Page credentials for /api/cron/facebook
# Page ID is the numeric id from https://graph.facebook.com/<PAGE_NAME>?fields=id
# Token needs the pages_manage_posts + pages_read_engagement permissions.
FB_PAGE_ID=
FB_PAGE_TOKEN=

# ---------------------------------------------------------------------------
# Dodo Payments
# ---------------------------------------------------------------------------
# Server-side API key (test: dodo_test_..., live: dodo_live_...)
DODO_PAYMENTS_API_KEY=

# Webhook signing secret from Dodo Dashboard > Webhooks.
# Used by /api/webhooks/dodo to verify the Standard Webhooks signature over
# `webhook-id.webhook-timestamp.raw_body`.
DODO_PAYMENTS_WEBHOOK_KEY=whsec_...

# test_mode | live_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Optional product-id -> plan mapping used when a payload has no metadata.plan
DODO_PRODUCT_LIFETIME=
DODO_PRODUCT_CREATOR=
DODO_PRODUCT_AGENCY=

# ---------------------------------------------------------------------------
# Supabase (optional)
# Without these the webhook still verifies + logs, but idempotency and grants
# only live in memory. See supabase/schema.sql.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=